<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>

<nav>
    <a class="logo" href="${pageContext.request.contextPath}/inicio">
        <img src="${pageContext.request.contextPath}/assets/img/logo.png" alt="Logo SoftFriends">
        <span>SoftFriends</span>
    </a>

    <form id="form-busqueda" action="${pageContext.request.contextPath}/catalogo" method="GET">
        <img src="${pageContext.request.contextPath}/assets/img/iconoBuscar.png" alt="Icono de búsqueda" class="search-icon" id="btn-buscar" style="cursor: pointer;">
        <input id="input-busqueda" name="txt_buscar" type="text" placeholder="Buscar productos...">
    </form>

    <ul>
        <c:choose>
            <c:when test="${not empty sessionScope.usuario}">
                <li>
                    Hola, ${sessionScope.nombreUsuario}
                </li>
                <li>
                    <a href="${pageContext.request.contextPath}/vistas/app/perfil.jsp"><img src="${pageContext.request.contextPath}/assets/img/configuracion.png" alt="Configuracion de la cuenta"></a>
                </li>
                <li>
                    <a href="#" id="btn-logout">Salir</a>
                </li>
            </c:when>

            <c:otherwise>
                <li>
                    <a href="${pageContext.request.contextPath}/vistas/auth/iniciar-sesion.jsp">
                        <img src="${pageContext.request.contextPath}/assets/img/iconoUsuario.png" alt="Iniciar Sesión">
                    </a>
                </li>
            </c:otherwise>
        </c:choose>

        <li>
            <a href="${pageContext.request.contextPath}/vistas/app/catalogo.jsp">
                <img src="${pageContext.request.contextPath}/assets/img/iconoCompra.png" alt="Carrito">
            </a>
        </li>
    </ul>
</nav>

<c:if test="${not empty sessionScope.usuario}">
    <script type="module" src="${pageContext.request.contextPath}/js/app/logout.js"></script>
</c:if>
