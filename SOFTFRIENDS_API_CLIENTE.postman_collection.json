    {
      "name": "03 - Carrito",
      "item": [
        {
          "name": "Obtener mi carrito",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Respuesta autorizada', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 401]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const carrito = pm.response.json();",
                  "    const items = carrito.itemsCarrito || [];",
                  "    if (items.length > 0) {",
                  "        const item = items[0];",
                  "        pm.collectionVariables.set('itemId', item.idItemCarrito || item.id || '');",
                  "        if (item.producto && item.producto.id) {",
                  "            pm.collectionVariables.set('productoId', item.producto.id);",
                  "        }",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/carrito",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "carrito"
              ]
            }
          },
          "response": []
        },
