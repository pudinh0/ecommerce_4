      "name": "01 - Auth",
      "item": [
        {
          "name": "Login cliente - guardar JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Login exitoso y token presente', function () {",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.message).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.collectionVariables.set('token', json.message);",
                  "if (json.usuario && json.usuario.correo) {",
                  "    pm.collectionVariables.set('userEmail', json.usuario.correo);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth"
              ]
            },
            "description": "Inicia sesion por API. El test guarda el JWT en la variable token."
          },
          "response": []
        },
        {
          "name": "Logout sesion web",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('token', '');",
                  "pm.test('Logout ejecutado', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logout"
              ]
            },
            "description": "Cierra la sesion del servidor. Para JWT, el cliente borra el token; el test limpia la variable token."
          },
          "response": []
        }
      ]
